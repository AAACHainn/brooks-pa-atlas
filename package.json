    "db:migrate": "node scripts/migrate-db.mjs",
    "db:init": "node scripts/init-db.mjs",
    "test:ai-robot": "tsx --conditions=react-server --test src/lib/ai-robot-route.test.ts src/lib/ai-robot-ui.test.ts src/lib/ai-robot-task.test.ts"
  },
