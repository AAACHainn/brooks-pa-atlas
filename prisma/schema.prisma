// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ImportBatchStatus {
  DRAFT
  IMPORTING
  PROCESSING_OCR
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ImportItemStatus {
  PENDING
  IMPORTED
  DUPLICATE
  FAILED
}

enum OcrStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ExamPaperStatus {
  DRAFT
  PUBLISHED
}

enum ExamQuestionStatus {
  DRAFT
  READY
}

enum ExamQuestionType {
  SINGLE
  MULTIPLE
}

enum ExamAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model IndexNode {
  id        String      @id @default(cuid())
  name      String
  parentId  String?
  parent    IndexNode?  @relation("IndexTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  IndexNode[] @relation("IndexTree")
  depth     Int         @default(0)
  path      String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  images      ChartImage[]
  importItems ImportItem[]
  navigatorOptions IndexNodeNavigatorOption[]

  @@index([parentId])
  @@index([path])
  @@unique([parentId, name])
}

model ChartImage {
  id            String    @id @default(cuid())
  libraryPath   String    @unique
  originalName  String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  hash          String    @unique
  title         String?
  notes         String?
  ocrText       String?
  ocrStatus     OcrStatus @default(PENDING)
  ocrError      String?
  ocrUpdatedAt  DateTime?
  indexNodeId   String?
  importBatchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  indexNode   IndexNode?   @relation(fields: [indexNodeId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importItem  ImportItem?
  examQuestions ExamQuestion[]
  tags          ChartImageTag[]
  annotations   ImageAnnotation[]

  @@index([indexNodeId])
  @@index([importBatchId])
  @@index([ocrStatus])
  @@index([originalName])
}

model IndexNavigatorCategory {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options IndexNavigatorOption[]

  @@index([sortOrder])
}

model IndexNavigatorOption {
  id             String   @id @default(cuid())
  categoryId     String
  name           String
  normalizedName String
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       IndexNavigatorCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nodeAssignments IndexNodeNavigatorOption[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, sortOrder])
}

model IndexNodeNavigatorOption {
  indexNodeId String
  optionId    String
  createdAt   DateTime @default(now())

  indexNode IndexNode            @relation(fields: [indexNodeId], references: [id], onDelete: Cascade)
  option    IndexNavigatorOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([indexNodeId, optionId])
  @@index([optionId])
}

model ImageAnnotation {
  id              String   @id @default(cuid())
  chartImageId    String
  text            String
  x               Float
  y               Float
  width           Float    @default(0.24)
  height          Float    @default(0.12)
  fontSize        Int      @default(18)
  color           String   @default("#111827")
  backgroundColor String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  chartImage ChartImage @relation(fields: [chartImageId], references: [id], onDelete: Cascade)

  @@index([chartImageId])
}

model Tag {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  images ChartImageTag[]

  @@index([name])
}

model ChartImageTag {
  chartImageId String
  tagId        String
  createdAt    DateTime @default(now())

  chartImage ChartImage @relation(fields: [chartImageId], references: [id], onDelete: Cascade)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([chartImageId, tagId])
  @@index([tagId])
}

model ImportBatch {
  id           String            @id @default(cuid())
  status       ImportBatchStatus @default(DRAFT)
  totalCount   Int               @default(0)
  successCount Int               @default(0)
  failedCount  Int               @default(0)
  duplicateCount Int             @default(0)
  ocrPendingCount Int            @default(0)
  ocrCompletedCount Int          @default(0)
  ocrFailedCount Int             @default(0)
  error        String?
  startedAt    DateTime          @default(now())
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  images ChartImage[]
  items  ImportItem[]

  @@index([status])
  @@index([createdAt])
}

model ImportItem {
  id            String           @id @default(cuid())
  batchId       String
  chartImageId  String?          @unique
  indexNodeId   String?
  originalName  String
  relativePath  String?
  savedPath     String?
  groupKey      String
  status        ImportItemStatus @default(PENDING)
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  batch      ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  chartImage ChartImage? @relation(fields: [chartImageId], references: [id], onDelete: SetNull)
  indexNode  IndexNode?  @relation(fields: [indexNodeId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([indexNodeId])
  @@index([status])
  @@index([groupKey])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExamPaper {
  id                 String          @id @default(cuid())
  title              String
  description        String?
  status             ExamPaperStatus @default(DRAFT)
  defaultOptionsJson String          @default("[]")
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([status])
  @@index([createdAt])
}

model ExamQuestion {
  id            String             @id @default(cuid())
  paperId       String
  chartImageId  String
  questionType  ExamQuestionType   @default(SINGLE)
  prompt        String             @default("")
  optionsJson   String             @default("[]")
  correctOption String?
  explanation   String             @default("")
  maskRectsJson String             @default("[]")
  status        ExamQuestionStatus @default(DRAFT)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  paper    ExamPaper   @relation(fields: [paperId], references: [id], onDelete: Cascade)
  image    ChartImage  @relation(fields: [chartImageId], references: [id], onDelete: Restrict)
  answers  ExamAttemptAnswer[]

  @@index([paperId])
  @@index([chartImageId])
  @@index([questionType])
  @@index([status])
  @@unique([paperId, chartImageId])
}

model ExamAttempt {
  id              String            @id @default(cuid())
  paperId         String
  status          ExamAttemptStatus @default(IN_PROGRESS)
  startedAt       DateTime          @default(now())
  submittedAt     DateTime?
  durationSeconds Int?
  totalCount      Int               @default(0)
  correctCount    Int               @default(0)
  accuracy        Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  paper   ExamPaper           @relation(fields: [paperId], references: [id], onDelete: Restrict)
  answers ExamAttemptAnswer[]

  @@index([paperId])
  @@index([status])
  @@index([createdAt])
}

model ExamAttemptAnswer {
  id          String   @id @default(cuid())
  attemptId   String
  questionId  String
  order       Int
  userAnswer  String?
  isCorrect   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@index([questionId])
  @@unique([attemptId, questionId])
  @@unique([attemptId, order])
}
