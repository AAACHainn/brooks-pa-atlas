    "test:ocr": "tsx --test src/lib/ocr-batch-job-state.test.ts src/lib/ocr-batch-jobs.test.ts",
    "test:ai": "tsx --test src/lib/ai-config.test.ts src/lib/ai-client.test.ts src/lib/ai-reading-companion.test.ts src/lib/ai-reading-route.test.ts src/lib/ai-deep-reading.test.ts src/lib/reading-companion-ui.test.ts src/lib/browser-id.test.ts && npm run test:ai-tools && npm run test:ai-robot && npm run test:ai-ocr-batch",
